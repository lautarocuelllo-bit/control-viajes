{
  "expo": {
    "name": "Control de viajes",
    "slug": "control-viajes",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.genesiscodestudio.controlviajes",
      "adaptiveIcon": {
        "backgroundColor": "#0c0c0d",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "lang": "es",
      "themeColor": "#0c0c0d",
      "backgroundColor": "#0c0c0d",
      "description": "Quién fue, cuánto se debe y quién ya pagó."
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font"
    ],
    "scheme": "controlviajes",
    "backgroundColor": "#0c0c0d",
    "experiments": {
      "typedRoutes": true
    }
  }
}
