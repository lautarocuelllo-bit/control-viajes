# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Project Settings > API). Las dos son públicas: no pongas acá la service_role ni la contraseña de la base.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
